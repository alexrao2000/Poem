config_version=5
[application]
config/name="Poem"
config/icon="res://assets/ui/poem-icon.svg"
boot_splash/image="res://assets/art/title-dawn-v1.png"
boot_splash/bg_color=Color(0.035,0.055,0.08,1)
config/use_custom_user_dir=true
config/custom_user_dir_name="Poem"
run/main_scene="res://main.tscn"
[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035,0.055,0.08,1)
[audio]
general/default_playback_type=0
